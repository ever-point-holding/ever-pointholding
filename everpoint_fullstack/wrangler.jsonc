{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everpoint-holding",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everpoint-holding",
      "database_id": "5ebfe98c-7688-44c5-be66-24adb6cd6701"
    }
  ],
  "vars": {
    "SESSION_DAYS": "7"
  }
}
